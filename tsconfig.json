{
  "compilerOptions": {
    "target": "ES2021", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true
  },
  "include": ["src", "tests"]
}
